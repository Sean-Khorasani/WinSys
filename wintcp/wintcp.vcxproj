  <!-- IDE output goes under build\ide\<Platform>\<Config>\ so it does not clash with the project build's build\wintcp.exe -->
  <!-- Use ProjectDir-relative paths so both .sln and direct .vcxproj builds land in the same folder. -->
  <!-- GenerateManifest=false as a global property (not just Link metadata): the app manifest
       is already embedded via wintcp.rc (RT_MANIFEST id 1). Letting the linker auto-generate
       a second manifest causes CVT1100/LNK1123 duplicate-manifest failures. -->
  <PropertyGroup>
    <OutDir>$(ProjectDir)..\build\ide\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)..\build\ide\$(Platform)\$(Configuration)\obj\</IntDir>
    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>
  <!-- Console, not Windows, in all four configs below: the entry point is wmain
       (see src/main.cpp), so <SubSystem>Windows</SubSystem> fails the link with
       LNK2001 "unresolved external symbol WinMain" - and a WINDOWS exe hands an
       interactive prompt back early, so CLI output lands on top of it. This must
       stay in step with the project build's /SUBSYSTEM:CONSOLE. -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <ClCompile>
      <!-- The CRT: /MT, stated explicitly. MSBuild's default is
           MultiThreadedDLL (/MD), which produced a Release binary importing
           MSVCP140.dll / VCRUNTIME140.dll / VCRUNTIME140_1.dll - absent on a
           clean machine, and a loader-raised "code execution cannot proceed"
           dialog before any WinTCP code runs. For a diagnostic tool copied onto
           machines you do not administer, no prerequisite is the right call.
           MultiThreadedDebug for the Debug configurations; writing
           "MultiThreaded" flat would break them. -->
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;_WIN32_WINNT=0x0601;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <TreatWarningAsError>true</TreatWarningAsError>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalOptions>/utf-8 /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <SupportJustMyCode>true</SupportJustMyCode>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <GenerateManifest>false</GenerateManifest>
      <EnableControlFlowGuard>true</EnableControlFlowGuard>
      <AdditionalDependencies>user32.lib;gdi32.lib;comdlg32.lib;shell32.lib;iphlpapi.lib;ws2_32.lib;comctl32.lib;psapi.lib;advapi32.lib;crypt32.lib;wintrust.lib;pdh.lib;ole32.lib;oleaut32.lib;bcrypt.lib;delayimp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <DelayLoadDLLs>comdlg32.dll;crypt32.dll;ole32.dll;oleaut32.dll;pdh.dll;shell32.dll</DelayLoadDLLs>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
