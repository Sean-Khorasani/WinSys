  <!-- The development test driver. Bench.cpp (selftest / bench) and
       UiHarness.cpp (the old uiharness switch) moved OUT of wintcp.exe on
       2026-10-02; they
       are compiled here instead, and the product project no longer lists them.
       This binary is NOT distributed. See ../the size notes section 7.
       Output goes under build\ide\dev\ so it cannot be mistaken for, or
       overwrite, the product at build\ide\<Platform>\<Config>\wintcp.exe. -->
  <PropertyGroup>
    <OutDir>$(ProjectDir)..\..\build\ide\dev\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)..\..\build\ide\dev\$(Platform)\$(Configuration)\obj\</IntDir>
    <!-- Same as the product project: wintcp.rc already embeds RT_MANIFEST id 1,
         and a second linker-generated manifest gives CVT1100 then LNK1123. -->
    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>
