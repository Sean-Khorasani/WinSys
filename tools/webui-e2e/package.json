{
  "name": "wintcp-webui-e2e",
  "private": true,
  "version": "0.0.0",
  "description": "Dev-only Playwright checks for the WinTCP Web UI. Not part of the shipped product and not needed to build or run it.",
  "type": "module",
  "scripts": {
    "check": "node run-checks.mjs",
    "workflows": "node workflow-checks.mjs",
    "automation": "node isolated-checks.mjs automation-checks.mjs",
    "recipe-notification-delivery": "node recipe-notification-delivery-check.mjs",
    "recipe-schedule": "node recipe-schedule-check.mjs",
    "active-recipe": "node active-recipe-check.mjs",
    "restart": "node server-restart-checks.mjs",
    "incident-import": "node incident-import-check.mjs",
    "incident-replay": "node incident-replay-ui-check.mjs",
    "incident-recipe-trigger": "node incident-recipe-trigger-check.mjs",
    "shots": "node screenshots.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "^1.64.1",
    "axe-core": "4.10.2"
  }
}
